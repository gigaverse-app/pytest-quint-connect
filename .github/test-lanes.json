{
  "extends": "workflow",
  "graph": {
    "module_roots": [
      "src",
      "tests",
      "dogfood",
      "examples/lru_cache",
      "."
    ],
    "scoped_hooks": {
      "examples/lru_cache/conftest.py": "364e54f8375cf39a6d22e43d8020080a082f4caf"
    },
    "floor_budget": 8
  },
  "rules": [
    {
      "name": "python-environment",
      "when": [
        "pyproject.toml",
        "**/pyproject.toml",
        "uv.lock",
        "**/uv.lock",
        ".python-version",
        "pytest.ini",
        "**/pytest.ini"
      ],
      "select": ["all"],
      "reason": "the test environment; the Read the Docs documentation/requirements.{in,txt} are not part of it"
    }
  ],
  "disable_rules": ["bun-environment"]
}
